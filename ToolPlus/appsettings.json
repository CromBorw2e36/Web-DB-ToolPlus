{
  // Never put connection strings or passwords in this file — it goes to git.
  // Real values belong in appsettings.local.json (gitignored), see appsettings.local.example.json.
  // Each connection string is ONE MODULE. Add a string, restart, done — no code changes.
  // The name becomes the first URL segment, lowercased: "Billing" -> /billing/explorer
  //
  // No ConnectionStrings entry is declared here on purpose: an empty string would abort
  // startup, and the tool has no database of its own to point at.
  "ToolPlus": {
    // Module opened when the URL does not name one. Empty = first connection string.
    "DefaultModule": "",
    // Optional per-module extras. Key = connection string name.
    // AllowEdit here is ANDed with the global AllowEdit below AND the signed-in user's
    // permission: switching it off anywhere makes the module read-only.
    //   "Modules": {
    //     "Billing":   { "Name": "Billing", "Icon": "i-database", "AllowEdit": true },
    //     "Warehouse": { "Name": "Warehouse", "Icon": "i-users", "AllowEdit": false }
    //   }
    "Modules": {},
    // ToolPlus accounts live in its own SQLite file (table ToolUser); they are NOT shared
    // with the applications that own the data.
    // Bootstrap only takes effect while that table is empty, so a fresh install has a way in.
    // Once you can sign in, clear the password here and manage accounts at /user.
    "Bootstrap": {
      "Username": "",
      "Password": "",
      "FullName": ""
    },
    // How many days a session lives before requiring a fresh login.
    "SessionDays": 30,
    // Optional convenience link to the application that owns the data. Empty = no link shown.
    "HostApp": {
      "Name": "",
      "Url": ""
    },
    // ToolPlus's OWN session cookie. Keep it different from the cookie of any other app on
    // the same host: cookies are not scoped by port, so a shared name means signing in here
    // logs you out there.
    "CookieName": "tp_token",
    // Collation for accent-insensitive search. Use "" to keep accents significant.
    "SearchCollation": "Vietnamese_CI_AI",
    // Cap on rows returned per request
    "MaxRows": 500,
    "QueryTimeoutSeconds": 60,
    // false = the whole instance is read-only
    "AllowEdit": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
