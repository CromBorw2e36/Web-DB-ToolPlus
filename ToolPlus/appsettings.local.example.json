{
  // Copy this file to appsettings.local.json and fill in real values.
  // appsettings.local.json is gitignored, so secrets never reach the repository.

  // Each connection string = one module. Add a line here, restart, and you are done:
  // search, blueprints and audit all work against the new database with no code changes.
  // The name becomes the first URL segment, lowercased: "Billing" -> /billing/explorer
  //
  // Note: every module must be SQL Server — table structure is read from sys.objects.
  // No particular name is required; ToolPlus signs users in with its own accounts.
  "ConnectionStrings": {
    "Billing": "Data Source=<server>;Initial Catalog=<database>;User ID=<user>;Password=<password>;TrustServerCertificate=True",
    "Warehouse": "Data Source=<server>;Initial Catalog=<database>;User ID=<user>;Password=<password>;TrustServerCertificate=True"
  },
  "ToolPlus": {
    // Administrator created automatically while the ToolUser table is still empty (first install).
    // Once you can sign in, clear this password and add people at /user.
    "Bootstrap": {
      "Username": "<admin username>",
      "Password": "<password>",
      "FullName": "<full name>"
    },

    // Optional — only for a nicer display name and a per-module write lock.
    "Modules": {
      "Billing": { "Name": "Billing", "Icon": "i-users" },
      "Warehouse": { "Name": "Warehouse", "Icon": "i-database", "AllowEdit": false }
    },

    // Optional link back to the application that owns the data. Omit to hide the link.
    "HostApp": {
      "Name": "<application name>",
      "Url": "https://<host>"
    }
  }
}
