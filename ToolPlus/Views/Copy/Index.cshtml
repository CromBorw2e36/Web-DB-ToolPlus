@using ToolPlus.Common
@using Newtonsoft.Json
@inject IModuleContext Module
@{
    ViewData["Title"] = "Chép bảng từ DB khác";
    ViewData["Fill"] = true;

    var opt = ViewData["Options"] as ToolPlusOptions;
    var copyTarget = Module.Current.CopyTarget;
    var canApply = Module.CanEdit && copyTarget;
    var sources = ViewData["Sources"] ?? new object[0];
}

<div class="subbar">
    <svg width="15" height="15"><use href="#i-download" /></svg>
    <b style="font-size:13px">So sánh &amp; chép dữ liệu bảng từ database khác</b>
    <div class="spacer" style="flex:1 1 auto"></div>
    <span class="hint">
        Chỉ ghi vào <b>@Module.Current.Name</b> — database nguồn luôn chỉ được đọc
    </span>
</div>

@if (!copyTarget)
{
    <div class="grid-note">
        <svg width="15" height="15"><use href="#i-alert" /></svg>
        <span>
            <b>@Module.Current.Name</b> chưa được bật làm đích chép bảng — chỉ so sánh được, không ghi.
            Nếu đây đúng là database được phép ghi đè (bản backup, bản test), đặt
            <code>ToolPlus:Modules:@Module.Current.ConnectionKey:CopyTarget = true</code> rồi khởi động lại.
        </span>
    </div>
}

<div class="copy-setup">
    <div class="sync-cards">
        <div class="sync-card">
            <div class="sync-card-head">
                <svg width="14" height="14"><use href="#i-database" /></svg>
                <span>Nguồn — lấy dữ liệu từ</span>
                <span class="badge">chỉ đọc</span>
            </div>
            <div class="field">
                <label class="label" for="srcModule">Database</label>
                <select class="select" id="srcModule"></select>
            </div>
        </div>

        <div class="sync-arrow" aria-hidden="true">
            <svg width="18" height="18"><use href="#i-right" /></svg>
        </div>

        <div class="sync-card sync-card--target">
            <div class="sync-card-head">
                <svg width="14" height="14"><use href="#i-save" /></svg>
                <span>Đích — sẽ được ghi</span>
                <span class="badge badge--pk">@Module.Current.Name</span>
            </div>
            <div class="field">
                <label class="label">Database</label>
                <input class="input" value="@Module.Current.Name" disabled
                       title="Luôn là database đang mở. Muốn ghi vào database khác thì đổi ở thanh trên cùng." />
            </div>
        </div>
    </div>

    <div class="copy-pick">
        <div class="copy-pick-bar">
            <div class="search-wrap" style="flex:1 1 220px">
                <svg width="14" height="14"><use href="#i-search" /></svg>
                <input class="input" id="tblFilter" placeholder="Lọc bảng…" autocomplete="off" spellcheck="false" />
            </div>
            <label class="check" title="Ẩn các bảng có số dòng hai bên bằng nhau (theo thống kê, không chính xác tuyệt đối)">
                <input type="checkbox" id="onlyDiff" /> Chỉ bảng lệch số dòng
            </label>
            <button type="button" class="btn btn--ghost" id="btnPickShown">Chọn hết đang hiện</button>
            <button type="button" class="btn btn--ghost" id="btnPickNone">Bỏ chọn</button>
            <span class="hint" id="pickCount"></span>
            <div class="spacer" style="flex:1 1 auto"></div>
            <button type="button" class="btn" id="btnStop" hidden>
                <svg width="14" height="14"><use href="#i-x" /></svg> Dừng
            </button>
            <button type="button" class="btn btn--primary" id="btnCompare">
                <svg width="14" height="14"><use href="#i-play" /></svg> So sánh
            </button>
        </div>
        <div class="copy-list" id="tblList"></div>
    </div>
</div>

<div class="grid-note" id="note" hidden></div>

<div class="copy-sum" id="sumWrap" hidden></div>

<div class="sync-chips" id="detailHead" hidden></div>

<div class="grid-wrap" id="gridWrap"></div>

<div class="savebar" id="applyBar" hidden>
    <svg width="15" height="15"><use href="#i-alert" /></svg>
    <span id="applyText"></span>
    <div class="spacer" style="flex:1 1 auto"></div>
    <button type="button" class="btn btn--accent" id="btnApply">
        <svg width="14" height="14"><use href="#i-download" /></svg> Xem &amp; kéo dữ liệu
    </button>
</div>

<div class="foot">
    <span class="stat">Bảng <b id="statTables">0</b></span>
    <span class="stat" id="statProgress"></span>
    <div class="spacer"></div>
    <button type="button" class="btn btn--ghost" id="btnCsv" title="Xuất các dòng lệch của bảng đang xem ra CSV">
        <svg width="14" height="14"><use href="#i-download" /></svg> CSV
    </button>
</div>

<div class="modal" id="modal">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div class="modal-head">
            <svg width="16" height="16"><use href="#i-download" /></svg>
            <h3 id="modalTitle">Xác nhận</h3>
            <button type="button" class="icon-btn" data-close aria-label="Đóng">
                <svg width="15" height="15"><use href="#i-x" /></svg>
            </button>
        </div>
        <div class="modal-body" id="modalBody"></div>
        <div class="modal-foot">
            <span class="hint" id="modalHint"></span>
            <div class="spacer"></div>
            <button type="button" class="btn" data-close>Huỷ</button>
            <button type="button" class="btn btn--accent" id="modalOk">Ghi</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.TP_COPY = {
            canApply: @(canApply ? "true" : "false"),
            currentModule: '@Module.Current.Key',
            currentName: @Html.Raw(JsonConvert.SerializeObject(Module.Current.Name)),
            maxListed: @(opt?.Copy.MaxListedRows ?? 500),
            sources: @Html.Raw(JsonConvert.SerializeObject(sources))
        };
    </script>
    <script src="~/js/pages/copy.js" asp-append-version="true"></script>
}
