@* Layout with no topbar — used for login / maintenance / error pages. *@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] · ToolPlus</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Fira+Sans:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/toolplus.css" asp-append-version="true" />
    <script>
        // Apply the theme before the first paint, to avoid a light/dark flash.
        (function () { try { var t = localStorage.getItem('tp-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) { } })();
        // Sign-in and a forced password change belong to the whole window, not to one workspace tab:
        // signing in inside a tab would leave every other tab still pointing at the dead session.
        (function () { try { if (window.self !== window.top && /^\/login(\/(index|doimatkhau)?)?\/?$/i.test(location.pathname)) window.top.location.replace(location.href); } catch (e) { } })();
    </script>
</head>
<body>
    <partial name="_Icons" />
    @RenderBody()
    <div class="toasts" id="toasts"></div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
