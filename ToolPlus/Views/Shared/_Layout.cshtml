@using ToolPlus.Common
@using ToolPlus.Models.ToolEntity
@using ToolPlus.Services.Interface
@inject IModuleContext Module
@inject ModuleRegistry Registry
@{
    var currentUser = ViewData["CurrentUser"] as ToolUser;
    var session = ViewData["Session"] as SessionInfo;
    var opt = ViewData["Options"] as ToolPlusOptions;

    // Only list modules this user can open — showing the name of a database they have no rights to,
    // just so clicking it lands on a "not authorised" page, is worse than not showing it.
    var myModules = Registry.All.Where(m =>
        currentUser?.IsAdmin == true
        || session?.Modules.Any(x => string.Equals(x.ModuleKey, m.Key, StringComparison.OrdinalIgnoreCase)) == true
    ).ToList();
    var name = currentUser?.FullName ?? currentUser?.Username ?? "";
    var initials = string.Join("", name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Select(p => p[0]).TakeLast(2)).ToUpper();

    // A page that must fill the viewport and scroll internally (e.g. Explorer) sets ViewData["Fill"] = true.
    var fill = ViewData["Fill"] as bool? ?? false;

    // The tab workspace (/home/tabs) is the one page that hosts other pages instead of being one.
    var workspace = ViewData["Workspace"] as bool? ?? false;
    var tabsUrl = Module.Url("/home/tabs");
    var here = Context.Request.Path.Value + Context.Request.QueryString.Value;
}
<!DOCTYPE html>
<html lang="vi" data-workspace="@(workspace ? "" : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] · ToolPlus</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Fira+Sans:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/toolplus.css" asp-append-version="true" />
    @* The current module, so JS can prefix every fetch with it (TP.u). Stamped on <html> rather
       than a global variable so it is available from the very first line of script. *@
    <script>document.documentElement.dataset.module = '@Module.Current.Key';</script>
    <script>
        // Apply theme and sidebar state before the first paint, to avoid a flash.
        (function () {
            // Inside a workspace tab: the workspace already draws the topbar and the menu, so this
            // page hides its own (CSS keys off data-embed). A cross-origin parent throws — still a frame.
            var embed;
            try { embed = window.self !== window.top; } catch (e) { embed = true; }
            if (embed) document.documentElement.dataset.embed = '';

            try {
                var t = localStorage.getItem('tp-theme');
                if (t) document.documentElement.dataset.theme = t;
                if (localStorage.getItem('tp-nav') === 'collapsed') document.documentElement.dataset.nav = 'collapsed';
            } catch (e) { }
        })();
    </script>
    @if (!workspace)
    {
        <script>
            // Tab mode is remembered per browser: once on, any page opened on its own (a bookmark, a
            // pasted link) becomes a tab of the workspace instead. Done before <body> is parsed, so the
            // page's own scripts never start — they would fire their first queries for nothing.
            (function () {
                try {
                    if (window.self !== window.top || localStorage.getItem('tp-tabs') !== 'on') return;
                    location.replace('@tabsUrl?open=' + encodeURIComponent(location.pathname + location.search + location.hash));
                } catch (e) { }
            })();
        </script>
    }
</head>
<body>
    <partial name="_Icons" />

    <div class="app">
        <header class="topbar">
            <button type="button" class="icon-btn nav-drawer-toggle" id="navDrawerToggle"
                    title="Menu" aria-label="Menu">
                <svg width="17" height="17"><use href="#i-menu" /></svg>
            </button>

            <a class="brand" href="@Module.Url("/home/index")">
                <svg width="18" height="18"><use href="#i-database" /></svg>
                <span>ToolPlus</span>
            </a>

            @if (myModules.Count > 1)
            {
                <select class="select module-switch" id="moduleSwitch" aria-label="Database đang mở"
                        title="Database đang mở — đổi ở đây là đổi cả đường dẫn">
                    @foreach (var m in myModules)
                    {
                        <option value="@m.Key" selected="@(m.Key == Module.Current.Key)">@m.Name</option>
                    }
                </select>
            }
            else
            {
                <b class="module-tag" title="@Module.Current.ConnectionKey">@Module.Current.Name</b>
            }

            @await RenderSectionAsync("Topbar", required: false)

            <div class="spacer"></div>

            @if (workspace)
            {
                <button type="button" class="btn btn--ghost topbar-tabs" id="tabsExit"
                        title="Tắt chế độ nhiều tab — về lại một trang mỗi cửa sổ, mở trang của tab đang xem">
                    <svg width="14" height="14"><use href="#i-tabs" /></svg><span>Thoát nhiều tab</span>
                </button>
            }
            else
            {
                <a class="btn btn--ghost topbar-tabs" id="tabsEnter" href="@tabsUrl?open=@Uri.EscapeDataString(here)"
                   title="Mở nhiều trang trong cùng một cửa sổ, chuyển qua lại bằng tab">
                    <svg width="14" height="14"><use href="#i-tabs" /></svg><span>Nhiều tab</span>
                </a>
            }

            <button type="button" class="icon-btn" id="themeToggle" title="Đổi sáng/tối" aria-label="Đổi sáng/tối">
                <svg width="17" height="17" data-theme-icon><use href="#i-moon" /></svg>
            </button>

            @if (currentUser != null)
            {
                <div class="user-chip" title="@currentUser.Username">
                    <strong>@name</strong>
                    <span class="avatar">@initials</span>
                </div>
                <a class="icon-btn" href="/login/logout" title="Đăng xuất @currentUser.Username" aria-label="Đăng xuất">
                    <svg width="17" height="17"><use href="#i-logout" /></svg>
                </a>
            }
        </header>

        @if (opt != null && !opt.AllowEdit)
        {
            <div class="banner">
                <svg width="15" height="15"><use href="#i-alert" /></svg>
                Đang ở chế độ chỉ đọc (<code>ToolPlus:AllowEdit = false</code>) — không sửa được dữ liệu.
            </div>
        }

        <div class="shell">
            <partial name="_Nav" />
            <div class="nav-scrim" id="navScrim"></div>

            <main class="content @(fill ? "content--fill" : "")">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="toasts" id="toasts"></div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
